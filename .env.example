# LLM -- "ollama" (default, fully local) or "openrouter" (cloud, opt-in).
# OpenRouter means questions and document content leave this machine; only switch to it if you
# understand and accept that. Get a free key at https://openrouter.ai/keys, then set
# LLM_PROVIDER=openrouter and OPENROUTER_API_KEY below. See README for the full walkthrough.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Embeddings (local, in-process via sentence-transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store
VECTOR_DB=chroma
VECTOR_DB_PATH=./data/processed/chroma_db

# Web search fallback (Phase 4) -- used only when local retrieval is still weak after
# corrective retrieval AND the /ask request opts in with "web_fallback": true.
# duckduckgo requires no API key/signup.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10.0

# Retrieval / correction tuning
TOP_K=8
RELEVANCE_THRESHOLD=0.65
ANSWER_GROUNDING_THRESHOLD=0.75
MAX_RETRIEVAL_ROUNDS=2
MAX_ANSWER_CORRECTIONS=1

# Retrieval quality scoring (Phase 2)
QUALITY_WEIGHT_MEAN=0.50
QUALITY_WEIGHT_BEST=0.30
QUALITY_WEIGHT_RELEVANT_RATIO=0.20
RETRIEVAL_QUALITY_HIGH_THRESHOLD=0.75
RETRIEVAL_QUALITY_MEDIUM_THRESHOLD=0.55
GRADER_MAX_RETRIES=2

# Evidence builder (Phase 5)
MAX_CONTEXT_CHARS=8000

# RAGAS evaluation (Phase 7) -- a larger local model tends to be a more reliable RAGAS judge
# than the small pipeline model, since RAGAS does its own multi-step claim decomposition
# internally. Leave blank to reuse LLM_MODEL as the judge too.
RAGAS_JUDGE_MODEL=qwen2.5:7b-instruct

# App
APP_ENV=development
LOG_LEVEL=INFO
