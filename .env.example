# LLM (local, via Ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# Embeddings (local, in-process via sentence-transformers)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vector store
VECTOR_DB=chroma
VECTOR_DB_PATH=./data/processed/chroma_db

# Web search fallback (Phase 4) -- used only when local retrieval is still weak after
# corrective retrieval AND the /ask request opts in with "web_fallback": true.
# duckduckgo requires no API key/signup.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10.0

# Retrieval / correction tuning
TOP_K=8
RELEVANCE_THRESHOLD=0.65
ANSWER_GROUNDING_THRESHOLD=0.75
MAX_RETRIEVAL_ROUNDS=2
MAX_ANSWER_CORRECTIONS=1

# Retrieval quality scoring (Phase 2)
QUALITY_WEIGHT_MEAN=0.50
QUALITY_WEIGHT_BEST=0.30
QUALITY_WEIGHT_RELEVANT_RATIO=0.20
RETRIEVAL_QUALITY_HIGH_THRESHOLD=0.75
RETRIEVAL_QUALITY_MEDIUM_THRESHOLD=0.55
GRADER_MAX_RETRIES=2

# App
APP_ENV=development
LOG_LEVEL=INFO
